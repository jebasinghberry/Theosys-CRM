# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-with-a-long-random-development-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# SQLite is only a quick local smoke-test default. PostgreSQL is required for shared/production use.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=nugabest_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# Enable these after HTTPS is correctly configured.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
